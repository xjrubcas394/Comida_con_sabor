import { useState, useEffect } from 'react'

function App() {
  // 1. Estado para guardar los productos y si está cargando
  const [productos, setProductos] = useState([])
  const [cargando, setCargando] = useState(true)

  // 2. useEffect se ejecuta automáticamente cuando el componente carga
  useEffect(() => {
    // 3. Hacemos la petición (fetch) a nuestra API de Django
    fetch('http://localhost:8000/api/catalogo/productos/')
      .then(respuesta => respuesta.json())
      .then(datos => {
        setProductos(datos)
        setCargando(false)
      })
      .catch(error => {
        console.error("Error al cargar los productos:", error)
        setCargando(false)
      })
  }, [])

  return (
    <div className="min-h-screen bg-gray-50 p-8">
      {/* Header o Cabecera */}
      <header className="mb-12 text-center">
        <h1 className="text-4xl font-bold text-gray-900 mb-2">Comida Con Sabor</h1>
        <p className="text-lg text-gray-600">Catálogo Gourmet Artesanal</p>
      </header>

      {/* Contenido principal */}
      {cargando ? (
        <p className="text-center text-gray-500">Cargando delicias...</p>
      ) : (
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
          {/* 4. Recorremos el array de productos y pintamos una "tarjeta" por cada uno */}
          {productos.length > 0 ? (
            productos.map(producto => (
              <div key={producto.id} className="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
                {/* 5. Si el producto tiene imágenes, mostramos la primera (o una genérica si no tiene) */}
                <div className="h-48 bg-gray-200 overflow-hidden">
                  {producto.imagenes && producto.imagenes.length > 0 ? (
                    <img 
                      // Fíjate en cómo construimos la URL completa para la imagen
                      src={producto.imagenes[0].imagen}
                      alt={producto.nombre} 
                      className="w-full h-full object-cover"
                    />
                  ) : (
                    <div className="w-full h-full flex items-center justify-center text-gray-400">
                      Sin imagen
                    </div>
                  )}
                </div>

                {/* 6. Detalles del producto */}
                <div className="p-6">
                  <div className="flex justify-between items-start mb-2">
                    <h2 className="text-xl font-bold text-gray-800">{producto.nombre}</h2>
                    <span className="text-lg font-semibold text-green-600">{producto.precio}€</span>
                  </div>
                  
                  {/* Etiquetas de Trazabilidad y Categoría */}
                  <div className="flex flex-wrap gap-2 mb-4">
                    <span className="px-2 py-1 bg-blue-100 text-blue-800 text-xs font-semibold rounded-full">
                      {producto.categoria_nombre || "Sin Categoría"}
                    </span>
                    {producto.es_km0 && (
                      <span className="px-2 py-1 bg-green-100 text-green-800 text-xs font-semibold rounded-full">Km0</span>
                    )}
                    {producto.es_organico && (
                      <span className="px-2 py-1 bg-yellow-100 text-yellow-800 text-xs font-semibold rounded-full">Orgánico</span>
                    )}
                  </div>

                  <p className="text-gray-600 text-sm mb-4 line-clamp-3">
                    {producto.historia || "Sin historia disponible."}
                  </p>

                  <div className="pt-4 border-t border-gray-100 text-sm text-gray-500">
                    Productor: <span className="font-medium text-gray-700">{producto.productor_nombre}</span>
                  </div>
                </div>
              </div>
            ))
          ) : (
             <p className="text-center col-span-full text-gray-500">No hay productos disponibles en el catálogo.</p>
          )}
        </div>
      )}
    </div>
  )
}

export default App